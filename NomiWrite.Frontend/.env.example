# Frontend runtime mode.
# Use "real" when the API Gateway and target backend endpoint are running.
# Keep "mock" for local demo fallback while unfinished backend services still throw NotImplementedException.
NEXT_PUBLIC_API_MODE=mock

# Backend API gateway base URL. Matches NomiWrite.Gateway launchSettings.json.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5097

# Google OAuth Client ID for Google Identity Services.
# Frontend receives a Google credential/id_token and sends it to POST /api/auth/google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
