# Shared Supabase Postgres connection for all local backend services.
# Replace the password locally or set this as ConnectionStrings__SupabaseDb in PowerShell.
SUPABASE_DB_CONNECTION_STRING=Host=db.szepbaxufcksxcauselh.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_SUPABASE_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# RabbitMQ is still required for cross-service events.
RabbitMQ__Host=localhost
RabbitMQ__Username=guest
RabbitMQ__Password=guest
