# ── RabbitMQ ──────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123
RabbitMQ__Username=admin
RabbitMQ__Password=admin123

# ── Database Connection Strings (Supabase — must exist before running Docker) ──
ConnectionStrings__AuthDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_auth;Username=postgres;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__UserDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_user;Username=postgres;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__PaymentDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_payment;Username=postgres;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__WritingDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_writing;Username=postgres;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__GradingDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_grading;Username=postgres;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__SubscriptionDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_subscription;Username=postgres;Password=<password>;SSL Mode=Require;Trust Server Certificate=true

# ── JWT (identical across all services) ──────────────────────────
JwtSettings__Secret=YOUR_SUPER_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG
JwtSettings__Issuer=NomiWriteAuthService
JwtSettings__Audience=NomiWriteClients

# ── SMTP (Auth service) ─────────────────────────────────────────
SmtpSettings__Host=smtp.gmail.com
SmtpSettings__Port=587
SmtpSettings__Username=you@gmail.com
SmtpSettings__Password=your-app-password
SmtpSettings__FromEmail=you@gmail.com

# ── Google OAuth (Auth service) ─────────────────────────────────
GoogleAuth__ClientId=your-google-client-id.apps.googleusercontent.com

# ── Gemini AI (AICoordinator service) ────────────────────────────
GeminiSettings__ApiKey=your-gemini-api-key
GeminiSettings__Model=gemini-2.5-flash
GeminiSettings__Endpoint=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent

# ── VNPay (Payment service) ──────────────────────────────────────
VnPaySettings__TmnCode=your-tmn-code
VnPaySettings__HashSecret=your-hash-secret
VnPaySettings__ReturnUrl=http://localhost:3000/payment/vnpay-return
VnPaySettings__IpnUrl=https://your-ngrok-url.ngrok-free.dev/api/payment/vnpay/ipn

# ── Momo (Payment service) ──────────────────────────────────────
MomoSettings__PartnerCode=MOMO
MomoSettings__AccessKey=your-access-key
MomoSettings__SecretKey=your-secret-key
MomoSettings__RedirectUrl=http://localhost:3000/payment/momo-return
MomoSettings__IpnUrl=https://your-ngrok-url.ngrok-free.dev/api/payment/momo/ipn
