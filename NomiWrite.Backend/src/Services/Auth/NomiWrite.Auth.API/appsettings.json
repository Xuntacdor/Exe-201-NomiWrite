{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDb": "Host=your_db_host;Port=5432;Database=your_db_name;Username=your_db_user;Password=your_db_password;SSL Mode=Require;Trust Server Certificate=true"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "your_rabbitmq_username",
    "Password": "your_rabbitmq_password"
  },
  "JwtSettings": {
    "Secret": "YOUR_SUPER_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "NomiWriteAuthService",
    "Audience": "NomiWriteClients",
    "ExpirationInMinutes": 60
  }
}