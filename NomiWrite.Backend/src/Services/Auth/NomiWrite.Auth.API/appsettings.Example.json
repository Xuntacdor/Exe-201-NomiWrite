{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDb": "Host=<pg-host>;Port=5432;Database=nomiwrite_auth;Username=<pg-user>;Password=<pg-password>;SSL Mode=Require;Trust Server Certificate=true"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "admin",
    "Password": "admin123"
  },
  "AppSettings": {
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "<smtp-username>",
    "Password": "<smtp-app-password>",
    "FromEmail": "<from-email>",
    "FromName": "NomiWrite",
    "EnableSsl": true
  },
  "JwtSettings": {
    "Secret": "<at-least-32-characters>",
    "Issuer": "NomiWriteAuthService",
    "Audience": "NomiWriteClients",
    "ExpirationInMinutes": 60
  },
  "GoogleAuth": {
    "ClientId": "<google-oauth-client-id>"
  }
}
