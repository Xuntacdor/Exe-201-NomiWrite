{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PaymentDb": "Host=<pg-host>;Port=5432;Database=nomiwrite_payment;Username=<pg-user>;Password=<pg-password>;SSL Mode=Require;Trust Server Certificate=true"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "admin",
    "Password": "admin123"
  },
  "JwtSettings": {
    "Secret": "<at-least-32-characters>",
    "Issuer": "NomiWriteAuthService",
    "Audience": "NomiWriteClients",
    "ExpirationInMinutes": 60
  },
  "VnPaySettings": {
    "TmnCode": "<vnpay-tmn-code>",
    "HashSecret": "<vnpay-hash-secret>",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "http://localhost:3000/payment/vnpay-return",
    "IpnUrl": "http://localhost:5097/api/payment/vnpay/ipn"
  },
  "MomoSettings": {
    "PartnerCode": "MOMO",
    "AccessKey": "<momo-access-key>",
    "SecretKey": "<momo-secret-key>",
    "Endpoint": "https://test-payment.momo.vn/v2/gateway/api/create",
    "RedirectUrl": "http://localhost:3000/payment/momo-return",
    "IpnUrl": "http://localhost:5097/api/payment/momo/ipn"
  },
  "ServiceUrls": {
    "SubscriptionService": "http://localhost:5160"
  }
}
