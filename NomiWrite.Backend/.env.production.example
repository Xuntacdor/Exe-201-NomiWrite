# ==============================================================================
# NomiWrite — Production environment template
# ------------------------------------------------------------------------------
# Copy to `.env.production`, fill in real values, keep it OUT of git
# (it is ignored; see .gitignore). NEVER commit real credentials.
#
#   cp .env.production.example .env.production
#   # edit .env.production   (DO NOT edit this example with real values)
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Every variable below is consumed by docker-compose.prod.yml, by the .NET
# microservices (via ASP.NET Core environment variable binding), or by the
# backup/restore scripts. Values are placeholders only.
# ==============================================================================

# ── ASP.NET environment (all services) ───────────────────────────────────────
# docker-compose.prod.yml also forces ASPNETCORE_ENVIRONMENT=Production as a
# belt-and-suspenders guard; keep it set here as well.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# ── MongoDB (Logging service — activity/audit logs) ──────────────────────────
# MONGO_INITDB_ROOT_* configure the MongoDB container itself.
# ConnectionStrings__MongoDb is read by the Logging service (MassTransit consumer
# writes + admin queries). Host is the Compose service name "mongodb".
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD
ConnectionStrings__MongoDb=mongodb://root:CHANGE_ME_MONGO_PASSWORD@mongodb:27017
MongoDb__DatabaseName=NomiWriteLogDb
MongoDb__TtlExpireAfterDays=180

# ── RabbitMQ broker + application consumers ──────────────────────────────────
# RABBITMQ_DEFAULT_* configures the broker container itself.
# RabbitMQ__* is read by every microservice (MassTransit).
# RabbitMQ__Host MUST be the Compose service name "rabbitmq" on the internal
# network — do not use localhost inside containers.
RABBITMQ_DEFAULT_USER=CHANGE_ME_RABBITMQ_USER
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD
RabbitMQ__Host=rabbitmq
RabbitMQ__Port=5672
RabbitMQ__Username=CHANGE_ME_RABBITMQ_USER
RabbitMQ__Password=CHANGE_ME_RABBITMQ_PASSWORD

# ── Supabase / PostgreSQL (one separate DATABASE per service — NOT schemas) ──
# Format: Host=db.<project-ref>.supabase.co;Port=5432;Database=<db>;Username=postgres;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
#
# Production databases (9):
#   nomiwrite_auth, nomiwrite_user, nomiwrite_payment, nomiwrite_writing,
#   nomiwrite_grading, nomiwrite_subscription, nomiwrite_notification,
#   nomiwrite_admin, nomiwrite_learning
#
# NOTE — port 5432 is the Supabase DIRECT connection, which is what pg_dump
# requires (see BACKUP_DB_* below). The transaction/session pooler (port 6543,
# PgBouncer) is NOT suitable for pg_dump. If you must use a pooler for the
# app runtime connections, keep the pattern Database=<db> and documented pools.
ConnectionStrings__AuthDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_auth;Username=postgres;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__UserDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_user;Username=postgres;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__PaymentDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_payment;Username=postgres;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__WritingDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_writing;Username=postgres;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__GradingDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_grading;Username=postgres;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__SubscriptionDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_subscription;Username=postgres;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__NotificationDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_notification;Username=postgres;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__AdminDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_admin;Username=postgres;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__LearningDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=nomiwrite_learning;Username=postgres;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true

# ── JWT (shared, must be identical across all services) ──────────────────────
JwtSettings__Secret=CHANGE_ME_AT_LEAST_32_CHARS_LONG_RANDOM_STRING
JwtSettings__Issuer=NomiWriteAuthService
JwtSettings__Audience=NomiWriteClients

# ── SMTP (Auth service) ──────────────────────────────────────────────────────
SmtpSettings__Host=smtp.gmail.com
SmtpSettings__Port=587
SmtpSettings__Username=CHANGE_ME_SMTP_USER
SmtpSettings__Password=CHANGE_ME_SMTP_APP_PASSWORD
SmtpSettings__FromEmail=CHANGE_ME_SMTP_FROM
SmtpSettings__FromName=NomiWrite
# Frontend base URL used in auth emails/links.
AppSettings__FrontendBaseUrl=https://CHANGE_ME_FRONTEND_DOMAIN

# ── Google OAuth (Auth service) ──────────────────────────────────────────────
GoogleAuth__ClientId=CHANGE_ME_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ── Gemini AI (AICoordinator + Learning services) ───────────────────────────
GeminiSettings__ApiKey=CHANGE_ME_GEMINI_API_KEY
GeminiSettings__Model=gemini-2.5-flash
GeminiSettings__Endpoint=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent

# ── VNPay (Payment service) ──────────────────────────────────────────────────
VnPaySettings__TmnCode=CHANGE_ME_VNPAY_TMNCODE
VnPaySettings__HashSecret=CHANGE_ME_VNPAY_HASH_SECRET
VnPaySettings__BaseUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VnPaySettings__ReturnUrl=https://CHANGE_ME_DOMAIN/payment/vnpay-return
VnPaySettings__IpnUrl=https://CHANGE_ME_DOMAIN/api/payment/vnpay/ipn

# ── Momo (Payment service) ───────────────────────────────────────────────────
MomoSettings__PartnerCode=MOMO
MomoSettings__AccessKey=CHANGE_ME_MOMO_ACCESS_KEY
MomoSettings__SecretKey=CHANGE_ME_MOMO_SECRET_KEY
MomoSettings__Endpoint=https://test-payment.momo.vn/gw_payment/transactionProcessor
MomoSettings__RedirectUrl=https://CHANGE_ME_DOMAIN/payment/momo-return
MomoSettings__IpnUrl=https://CHANGE_ME_DOMAIN/api/payment/momo/ipn

# ── Internal service URLs (service-to-service, over the internal network) ────
# docker-compose.prod.yml injects these with Docker DNS names already; the
# values below are the documented defaults and should match the Compose
# topology. Do not use localhost inside containers.
ServiceUrls__AuthService=http://auth-service:8080
ServiceUrls__WritingService=http://writing-service:8080
ServiceUrls__PaymentService=http://payment-service:8080
ServiceUrls__SubscriptionService=http://subscription-service:8080
ServiceUrls__AICoordinatorService=http://aicoordinator-service:8080

# ── Backup / restore (scripts/backup-db.sh, scripts/restore-db.sh) ───────────
# Dedicated Supabase DIRECT connection for pg_dump. Prefer port 5432 (direct)
# over 6543 (PgBouncer pooler). These variables are the ONLY place credentials
# for backups live; they are injected via PGPASSWORD (never on the command line).
BACKUP_DB_HOST=db.<project-ref>.supabase.co
BACKUP_DB_PORT=5432
BACKUP_DB_USER=postgres
BACKUP_DB_PASSWORD=CHANGE_ME_SUPABASE_DB_PASSWORD
# Optional: space-separated list of databases to back up. Default (all 9):
#   nomiwrite_auth nomiwrite_user nomiwrite_payment nomiwrite_writing
#   nomiwrite_grading nomiwrite_subscription nomiwrite_notification
#   nomiwrite_admin nomiwrite_learning
BACKUP_DB_NAMES=nomiwrite_auth nomiwrite_user nomiwrite_payment nomiwrite_writing nomiwrite_grading nomiwrite_subscription nomiwrite_notification nomiwrite_admin nomiwrite_learning
# Where backups are written. Inside the backup-service container this is
# forced to /backups (the nomiwrite-backups volume). On the host cron variant
# use an absolute path, e.g. /var/backups/nomiwrite.
BACKUP_DIR=/backups
# Number of days to retain *.sql.gz backups (files older than this, matching
# the *_backup_*.sql.gz pattern, are deleted). Default 7.
RETENTION_DAYS=7
# backup-service loop interval in seconds (default 86400 = daily).
BACKUP_INTERVAL_SECONDS=86400
# Timezone used for log timestamps inside the backup container / scripts.
# An explicit +07:00/UTC offset is always printed regardless.
TZ=Asia/Ho_Chi_Minh